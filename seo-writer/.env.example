# ============================================================================
#  SEO Article Writer — environment configuration
#  Copy this file to ".env" and fill in your values, OR set these as
#  environment variables in your hosting dashboard (Render / Railway / etc.)
# ============================================================================

# REQUIRED — your Anthropic API key (this is the billing account for all users)
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — customer access tokens, comma-separated. Hand one to each paying
# subscriber. They enter it in the app's ⚙️ Settings. Leave EMPTY only for
# local development — an empty value means the API is OPEN to anyone.
# Example: ACCESS_TOKENS=musteri-ali-8f3k,musteri-veli-2p9x,demo-7q1m
ACCESS_TOKENS=

# OPTIONAL — default model. Customers may pick another allowed model in-app.
#   claude-opus-4-7   → highest quality (most expensive)
#   claude-sonnet-4-6 → balanced (recommended default)
#   claude-haiku-4-5  → fastest / cheapest
MODEL=claude-sonnet-4-6

# OPTIONAL — allowed CORS origins, comma-separated, or * for any.
# If you serve the frontend from the same server, leave as *.
# If your frontend is on a different domain, list it: https://app.siteniz.com
ALLOWED_ORIGINS=*

# OPTIONAL — rate limit: requests per minute per access token (default 12)
RATE_LIMIT_PER_MIN=12

# OPTIONAL — port (most hosts set this automatically)
PORT=3000
